# Copia este archivo a .env y ajusta los valores.
# Los valores por defecto funcionan con XAMPP recién instalado.

# --- MySQL / MariaDB ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=acceso_usuarios
# Solo para Docker Compose (clave del usuario root del contenedor):
MYSQL_ROOT_PASSWORD=cambia-esta-clave

# --- Aplicación ---
SECRET_KEY=cambia-esta-clave-larga-y-aleatoria
SESSION_MINUTES=30
COOKIE_SECURE=0
SEED_DEMO=1
# Carpeta de la evidencia de los tickets (por defecto: adjuntos/ junto a run.py)
# CARPETA_ADJUNTOS=C:/ruta/a/adjuntos
